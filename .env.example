# ============================================================
# LabRepo — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Clerk Authentication ---
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# --- Database (PostgreSQL) ---
# For self-hosted (Docker Compose):
DATABASE_URL=postgresql://labrepo:labrepo_secret@postgres:5432/labrepo
# For managed (Neon, Supabase, etc.):
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- Storage (MinIO / S3) ---
# STORAGE_DRIVER: "minio" | "s3" | "mock" (default: mock)
STORAGE_DRIVER=minio

# MinIO (Docker Compose default):
AWS_ACCESS_KEY=minioadmin
AWS_SECRET_KEY=minioadmin
AWS_BUCKET=labrepo-storage
AWS_REGION=us-east-1
AWS_ENDPOINT=http://minio:9000

# For real AWS S3, set:
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY=your_access_key
# AWS_SECRET_KEY=your_secret_key
# AWS_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ENDPOINT=https://s3.us-east-1.amazonaws.com

# --- API Server ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=https://labrepo.app,http://localhost:4321,http://localhost:3000,http://127.0.0.1:4321,http://127.0.0.1:3000

# --- Frontend ---
HOST=0.0.0.0
PORT=4321

# --- Admin ---
ADMIN_USER_ID=your_clerk_user_id
CLERK_ADMIN_USER_ID=your_clerk_user_id

# --- Security (optional overrides) ---
# MAX_UPLOAD_SIZE=26214400          # 25 MB
# MAX_STORAGE_PER_USER=104857600    # 100 MB
# UPLOADS_PER_MINUTE=20
# MAX_REPOSITORIES=50
# LOGIN_RATE_LIMIT=10
# ALLOWED_FILE_TYPES=py,js,ts,...   # comma-separated

# --- CORS ---
# Comma-separated list of allowed origins (production)
# CORS_ORIGINS=https://your-domain.com

# --- MinIO Console (Docker only) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

---
import Layout from '../Layouts/Layout.astro';
import { Show } from '@clerk/astro/components';
---

<Layout title="Admin" showNav={true}>
  <Show when="signed-out">
    <div class="container py-12">
      <div class="admin-card admin-card--hero max-w-xl mx-auto">
        <div class="admin-card__icon-badge">
          <i class="bi bi-shield-lock"></i>
        </div>
        <h1 class="text-display-lg">Admin access required</h1>
        <p class="text-lead text-muted mt-2">Please sign in with an authorized account to view this moderation panel.</p>
      </div>
    </div>
  </Show>

  <Show when="signed-in">
    <div class="container page-content">
      <!-- Loading state -->
      <div id="admin-loading" class="empty-state">
        <div class="spinner"></div>
        <p class="text-muted">Loading admin panel...</p>
      </div>

      <!-- Access denied state -->
      <div id="admin-denied" class="empty-state" style="display: none;">
        <div class="text-hero text-muted mb-4"><i class="bi bi-shield-x"></i></div>
        <h3 class="text-display-lg mb-2">Access denied</h3>
        <p class="text-lead text-muted">Your account doesn't have admin privileges.</p>
      </div>

      <!-- Main admin content -->
      <div id="admin-content" style="display: none;">
        <!-- Page header -->
        <div class="page-header flex items-center justify-between mb-8">
          <div>
            <p class="admin-kicker">Moderation console</p>
            <h1 class="text-display-lg">Admin panel</h1>
            <p class="text-muted mt-1">Review metrics, manage users, and moderate abuse flags.</p>
          </div>
          <div class="flex gap-2 flex-wrap">
            <a href="/security-and-moderation" class="btn btn--dark-utility">
              <i class="bi bi-shield-check"></i><span class="hide-mobile"> Security &amp; moderation</span>
            </a>
          </div>
        </div>

        <!-- Tab navigation -->
        <div class="admin-tabs mb-8">
          <button class="admin-tab active" data-tab="overview"><i class="bi bi-speedometer2"></i> Overview</button>
          <button class="admin-tab" data-tab="users"><i class="bi bi-people"></i> Users</button>
          <button class="admin-tab" data-tab="learn"><i class="bi bi-book"></i> Learn</button>
        </div>

        <!-- ===== OVERVIEW TAB ===== -->
        <div id="tab-overview" class="admin-tab-content">
          <!-- Summary stats -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <div class="admin-stat-card">
              <div class="admin-stat-card__icon"><i class="bi bi-people"></i></div>
              <div>
                <p class="text-caption text-muted">Registered users</p>
                <p class="admin-stat-card__value" id="user-count">—</p>
              </div>
            </div>
            <div class="admin-stat-card">
              <div class="admin-stat-card__icon admin-stat-card__icon--warning"><i class="bi bi-flag"></i></div>
              <div>
                <p class="text-caption text-muted">Open abuse flags</p>
                <p class="admin-stat-card__value" id="flag-count">—</p>
              </div>
            </div>
            <div class="admin-stat-card">
              <div class="admin-stat-card__icon admin-stat-card__icon--info"><i class="bi bi-journal-text"></i></div>
              <div>
                <p class="text-caption text-muted">Audit log entries</p>
                <p class="admin-stat-card__value" id="audit-count">—</p>
              </div>
            </div>
          </div>

          <!-- Extended stats row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
            <div class="admin-stat-card admin-stat-card--compact">
              <i class="bi bi-hdd text-muted"></i>
              <div>
                <p class="text-caption text-muted">Total storage</p>
                <p class="admin-stat-card__value admin-stat-card__value--sm" id="storage-used">—</p>
              </div>
            </div>
            <div class="admin-stat-card admin-stat-card--compact">
              <i class="bi bi-cloud-upload text-muted"></i>
              <div>
                <p class="text-caption text-muted">Total uploads</p>
                <p class="admin-stat-card__value admin-stat-card__value--sm" id="total-uploads">—</p>
              </div>
            </div>
            <div class="admin-stat-card admin-stat-card--compact">
              <i class="bi bi-cloud-download text-muted"></i>
              <div>
                <p class="text-caption text-muted">Total downloads</p>
                <p class="admin-stat-card__value admin-stat-card__value--sm" id="total-downloads">—</p>
              </div>
            </div>
          </div>

          <!-- Audit + Flags columns -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
            <section class="admin-panel-section">
              <div class="admin-panel-section__header">
                <h2 class="text-body-strong"><i class="bi bi-clock-history"></i> Recent audit activity</h2>
                <span class="text-caption text-muted" id="audit-showing"></span>
              </div>
              <ul id="audit-list" class="admin-list">
                <li class="admin-list__placeholder text-muted text-caption">Loading...</li>
              </ul>
            </section>

            <section class="admin-panel-section">
              <div class="admin-panel-section__header">
                <h2 class="text-body-strong"><i class="bi bi-exclamation-triangle"></i> Open abuse flags</h2>
                <span class="text-caption text-muted" id="flag-showing"></span>
              </div>
              <ul id="flag-list" class="admin-list">
                <li class="admin-list__placeholder text-muted text-caption">Loading...</li>
              </ul>
            </section>
          </div>
        </div>

        <!-- ===== USERS TAB ===== -->
        <div id="tab-users" class="admin-tab-content" style="display: none;">
          <div class="admin-panel-section">
            <div class="admin-panel-section__header">
              <h2 class="text-body-strong"><i class="bi bi-people"></i> Registered users</h2>
              <span class="text-caption text-muted" id="user-list-count"></span>
            </div>
            <div id="user-list-loading" class="admin-list__placeholder text-muted text-caption">Loading users...</div>
            <div id="user-list-container"></div>
          </div>
        </div>

        <!-- ===== LEARN TAB ===== -->
        <div id="tab-learn" class="admin-tab-content" style="display: none;">
          <div class="admin-learn-grid">
            <!-- Abuse Flags -->
            <div class="admin-learn-card">
              <div class="admin-learn-card__header">
                <div class="admin-learn-card__icon"><i class="bi bi-exclamation-triangle"></i></div>
                <h3>Abuse flags</h3>
              </div>
              <p>Abuse flags are <strong>automatically created</strong> by the moderation engine when suspicious patterns are detected. They are never manually created.</p>
              <div class="admin-learn-card__rules">
                <div class="admin-learn-rule">
                  <span class="admin-badge admin-badge--danger">HIGH</span>
                  <div>
                    <strong>Upload burst</strong>
                    <p>Triggered when a user uploads <strong>≥ 50 files within 1 minute</strong>. Indicates potential spam or storage abuse.</p>
                  </div>
                </div>
                <div class="admin-learn-rule">
                  <span class="admin-badge admin-badge--danger">HIGH</span>
                  <div>
                    <strong>Login attack</strong>
                    <p>Triggered when <strong>≥ 5 failed login attempts</strong> are recorded for a user within 1 hour. Indicates brute-force attempts.</p>
                  </div>
                </div>
              </div>
              <p class="text-caption text-muted">Flags can be resolved from the Overview tab. Resolving a flag records an audit log entry with the admin's ID.</p>
            </div>

            <!-- Upload suspension -->
            <div class="admin-learn-card">
              <div class="admin-learn-card__header">
                <div class="admin-learn-card__icon admin-learn-card__icon--danger"><i class="bi bi-slash-circle"></i></div>
                <h3>Suspend uploads</h3>
              </div>
              <p>Suspending a user <strong>blocks all file uploads</strong> for that account. The user can still:</p>
              <ul class="admin-learn-card__list">
                <li><i class="bi bi-check-lg"></i> Sign in and view their dashboard</li>
                <li><i class="bi bi-check-lg"></i> Download existing files</li>
                <li><i class="bi bi-check-lg"></i> Search and browse their work</li>
                <li><i class="bi bi-x-lg text-danger"></i> Upload new files <span class="text-muted">(blocked)</span></li>
              </ul>
              <p class="text-caption text-muted">The user will see a clear error message explaining their uploads have been suspended. All suspend/restore actions are logged in the audit trail.</p>
            </div>

            <!-- Restore account -->
            <div class="admin-learn-card">
              <div class="admin-learn-card__header">
                <div class="admin-learn-card__icon admin-learn-card__icon--success"><i class="bi bi-arrow-counterclockwise"></i></div>
                <h3>Restore account</h3>
              </div>
              <p>Restoring a user <strong>re-enables file uploads</strong> for that account. Use this after reviewing the abuse flags and confirming the user's behavior is acceptable.</p>
              <p>Restoration is immediate — the user can upload files again on their next attempt.</p>
              <p class="text-caption text-muted">Every restore action is recorded in the audit log with the admin's user ID and timestamp.</p>
            </div>

            <!-- Audit logs -->
            <div class="admin-learn-card">
              <div class="admin-learn-card__header">
                <div class="admin-learn-card__icon admin-learn-card__icon--info"><i class="bi bi-journal-text"></i></div>
                <h3>Audit logs</h3>
              </div>
              <p>The audit log records <strong>every significant action</strong> taken in the system. Events tracked include:</p>
              <ul class="admin-learn-card__list">
                <li><i class="bi bi-cloud-upload"></i> File uploads and downloads</li>
                <li><i class="bi bi-trash3"></i> File, work, subject, and session deletions</li>
                <li><i class="bi bi-box-arrow-in-right"></i> User logins</li>
                <li><i class="bi bi-calendar-plus"></i> Session and subject creation</li>
                <li><i class="bi bi-shield-exclamation"></i> Admin actions (suspend, restore, resolve)</li>
                <li><i class="bi bi-exclamation-triangle"></i> Abuse flag creation</li>
              </ul>
              <p class="text-caption text-muted">Each entry includes user ID, IP address, user agent, timestamp, and contextual metadata. The Overview tab shows the 50 most recent entries.</p>
            </div>

            <!-- File limits -->
            <div class="admin-learn-card">
              <div class="admin-learn-card__header">
                <div class="admin-learn-card__icon"><i class="bi bi-file-earmark-check"></i></div>
                <h3>File &amp; storage limits</h3>
              </div>
              <p>The following limits are enforced system-wide:</p>
              <div class="admin-learn-card__table">
                <div><span class="text-muted">Max upload size</span><strong>25 MB per file</strong></div>
                <div><span class="text-muted">Max storage per user</span><strong>100 MB</strong></div>
                <div><span class="text-muted">Max files per request</span><strong>20 files</strong></div>
                <div><span class="text-muted">Upload rate limit</span><strong>20 per minute</strong></div>
                <div><span class="text-muted">Login rate limit</span><strong>10 per minute</strong></div>
                <div><span class="text-muted">Max repositories</span><strong>50 per user</strong></div>
              </div>
              <p class="text-caption text-muted mt-2">These can be overridden via environment variables: <code>MAX_UPLOAD_SIZE</code>, <code>MAX_STORAGE_PER_USER</code>, <code>UPLOADS_PER_MINUTE</code>, <code>LOGIN_RATE_LIMIT</code>, <code>MAX_REPOSITORIES</code>.</p>
            </div>

            <!-- Allowed file types -->
            <div class="admin-learn-card">
              <div class="admin-learn-card__header">
                <div class="admin-learn-card__icon"><i class="bi bi-filetype-py"></i></div>
                <h3>Allowed file types</h3>
              </div>
              <p>Only the following file extensions are allowed for upload:</p>
              <div class="admin-learn-card__tags" id="allowed-ext-list">
                <span class="admin-ext-tag">.py</span><span class="admin-ext-tag">.ipynb</span><span class="admin-ext-tag">.js</span><span class="admin-ext-tag">.ts</span><span class="admin-ext-tag">.java</span><span class="admin-ext-tag">.c</span><span class="admin-ext-tag">.cpp</span><span class="admin-ext-tag">.go</span><span class="admin-ext-tag">.rs</span><span class="admin-ext-tag">.html</span><span class="admin-ext-tag">.css</span><span class="admin-ext-tag">.json</span><span class="admin-ext-tag">.md</span><span class="admin-ext-tag">.txt</span><span class="admin-ext-tag">.pdf</span><span class="admin-ext-tag">.docx</span><span class="admin-ext-tag">.xlsx</span><span class="admin-ext-tag">.pptx</span><span class="admin-ext-tag">.sql</span><span class="admin-ext-tag">.csv</span><span class="admin-ext-tag">.yaml</span><span class="admin-ext-tag">.xml</span><span class="admin-ext-tag">.sh</span><span class="admin-ext-tag">.tex</span>
                <span class="admin-ext-tag admin-ext-tag--more">+more</span>
              </div>
              <p class="text-caption text-muted mt-2">Override with the <code>ALLOWED_FILE_TYPES</code> environment variable (comma-separated).</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", async () => {
        const api = (window as any).__labrepo_api;
        const showToast = (window as any).__labrepo_showToast;
        const formatSize = (window as any).__labrepo_formatSize;
        const formatRelativeTime = (window as any).__labrepo_formatRelativeTime;

        // Wait for Clerk to be ready
        await new Promise<void>((resolve) => {
          const check = () => {
            if ((window as any).Clerk?.session) resolve();
            else setTimeout(check, 100);
          };
          check();
        });

        const loadingEl = document.getElementById("admin-loading")!;
        const deniedEl = document.getElementById("admin-denied")!;
        const contentEl = document.getElementById("admin-content")!;

        // ===== Tab switching =====
        document.querySelectorAll(".admin-tab").forEach((tab: any) => {
          tab.addEventListener("click", () => {
            document.querySelectorAll(".admin-tab").forEach((t: any) => t.classList.remove("active"));
            document.querySelectorAll(".admin-tab-content").forEach((c: any) => c.style.display = "none");
            tab.classList.add("active");
            document.getElementById(`tab-${tab.dataset.tab}`)!.style.display = "block";

            // Lazy-load users tab
            if (tab.dataset.tab === "users" && !usersLoaded) {
              loadUsers();
            }
          });
        });

        let usersLoaded = false;

        // ===== Overview data =====
        async function loadOverview() {
          try {
            const summary = await api.getAdminSummary();
            loadingEl.style.display = "none";
            contentEl.style.display = "block";

            document.getElementById("user-count")!.textContent = String(summary.users);
            document.getElementById("flag-count")!.textContent = String(summary.openFlags);
            document.getElementById("audit-count")!.textContent = String(summary.auditLogCount);
            document.getElementById("storage-used")!.textContent = formatSize(summary.storageUsed || 0);
            document.getElementById("total-uploads")!.textContent = String(summary.totalUploads || 0);
            document.getElementById("total-downloads")!.textContent = String(summary.totalDownloads || 0);

            // Load audit logs
            const logs = await api.getAuditLogs();
            const auditList = document.getElementById("audit-list")!;
            auditList.innerHTML = "";
            if (!logs.logs?.length) {
              auditList.innerHTML = '<li class="admin-list__placeholder text-muted text-caption">No audit events yet.</li>';
            } else {
              document.getElementById("audit-showing")!.textContent = `Showing ${Math.min(logs.logs.length, 10)} of ${logs.logs.length}`;
              logs.logs.slice(0, 10).forEach((entry: any) => {
                const li = document.createElement("li");
                li.className = "admin-list__item animate-fade-in";
                const actionLabel = (entry.action || "unknown").replace(/_/g, " ");
                const timeAgo = entry.created_at ? formatRelativeTime(entry.created_at) : "unknown";
                const icon = getActionIcon(entry.action);
                li.innerHTML = `
                  <span class="admin-list__item-icon">${icon}</span>
                  <div class="admin-list__item-body">
                    <span class="text-caption">${actionLabel}</span>
                    <span class="text-caption text-muted">${timeAgo}${entry.user_id ? ` · ${entry.user_id.slice(0, 16)}…` : ""}</span>
                  </div>
                `;
                auditList.appendChild(li);
              });
            }

            // Load abuse flags
            const flags = await api.getAbuseFlags();
            const flagList = document.getElementById("flag-list")!;
            flagList.innerHTML = "";
            if (!flags.flags?.length) {
              flagList.innerHTML = '<li class="admin-list__placeholder text-muted text-caption"><i class="bi bi-check-circle"></i> No active abuse flags</li>';
            } else {
              document.getElementById("flag-showing")!.textContent = `Showing ${Math.min(flags.flags.length, 10)} of ${flags.flags.length}`;
              flags.flags.slice(0, 10).forEach((flag: any) => {
                const li = document.createElement("li");
                li.className = "admin-list__item admin-list__item--flag animate-fade-in";
                const severityClass = flag.severity === "high" ? "admin-badge--danger" : flag.severity === "medium" ? "admin-badge--warning" : "admin-badge--info";
                const timeAgo = flag.created_at ? formatRelativeTime(flag.created_at) : "unknown";
                li.innerHTML = `
                  <div class="admin-list__item-body" style="flex: 1; min-width: 0;">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-caption font-semibold">${(flag.type || "unknown").replace(/_/g, " ")}</span>
                      <span class="admin-badge ${severityClass}">${flag.severity || "—"}</span>
                      ${flag.resolved ? '<span class="admin-badge admin-badge--success">resolved</span>' : ""}
                    </div>
                    <span class="text-caption text-muted">${flag.reason || "No reason"} · ${timeAgo}</span>
                  </div>
                  ${!flag.resolved ? `<button class="btn btn--ghost btn--sm btn-resolve-flag" data-id="${flag.id}" title="Resolve flag"><i class="bi bi-check-lg"></i></button>` : ""}
                `;
                flagList.appendChild(li);
              });

              flagList.querySelectorAll(".btn-resolve-flag").forEach((btn: any) => {
                btn.addEventListener("click", async () => {
                  try {
                    await api.resolveFlag(parseInt(btn.dataset.id), "Resolved from admin panel");
                    showToast("Flag resolved", "success");
                    await loadOverview();
                  } catch (err: any) {
                    showToast(err.message || "Failed to resolve flag", "error");
                  }
                });
              });
            }
          } catch (error: any) {
            console.error("Admin load error:", error);
            if (error?.status === 403) {
              loadingEl.style.display = "none";
              deniedEl.style.display = "flex";
            } else {
              loadingEl.style.display = "none";
              contentEl.style.display = "block";
              document.getElementById("audit-list")!.innerHTML = '<li class="admin-list__placeholder text-muted text-caption">Unable to load admin data.</li>';
              document.getElementById("flag-list")!.innerHTML = '<li class="admin-list__placeholder text-muted text-caption">Unable to load admin data.</li>';
              showToast("Failed to load admin data", "error");
            }
          }
        }

        // ===== Users list =====
        async function loadUsers() {
          const container = document.getElementById("user-list-container")!;
          const loadingDiv = document.getElementById("user-list-loading")!;
          loadingDiv.style.display = "block";
          container.innerHTML = "";

          try {
            const { users } = await api.getAdminUsers();
            usersLoaded = true;
            loadingDiv.style.display = "none";
            document.getElementById("user-list-count")!.textContent = `${users.length} user${users.length !== 1 ? "s" : ""}`;

            if (!users.length) {
              container.innerHTML = '<div class="admin-list__placeholder text-muted text-caption">No registered users.</div>';
              return;
            }

            container.innerHTML = users.map((user: any) => {
              const isSuspended = Boolean(user.uploads_suspended);
              const hasFlags = (user.open_flags || 0) > 0;
              const timeAgo = user.created_at ? formatRelativeTime(user.created_at) : "—";
              const lastLogin = user.last_login_at ? formatRelativeTime(user.last_login_at) : "never";

              return `
                <div class="admin-user-row animate-fade-in ${isSuspended ? 'admin-user-row--suspended' : ''}">
                  <div class="admin-user-row__main">
                    <div class="admin-user-row__identity">
                      <div class="admin-user-row__avatar ${isSuspended ? 'admin-user-row__avatar--suspended' : ''}">
                        <i class="bi bi-person"></i>
                      </div>
                      <div class="admin-user-row__info">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="text-caption font-semibold admin-user-row__id">${user.clerk_id}</span>
                          ${isSuspended ? '<span class="admin-badge admin-badge--danger">suspended</span>' : ''}
                          ${hasFlags ? `<span class="admin-badge admin-badge--warning">${user.open_flags} flag${user.open_flags > 1 ? 's' : ''}</span>` : ''}
                          ${!user.onboarding_completed ? '<span class="admin-badge admin-badge--info">new</span>' : ''}
                        </div>
                        <div class="text-caption text-muted">
                          Joined ${timeAgo} · Last login ${lastLogin}
                        </div>
                      </div>
                    </div>
                    <div class="admin-user-row__stats hide-mobile">
                      <div class="admin-user-row__stat">
                        <span class="text-caption text-muted">Storage</span>
                        <span class="text-caption font-semibold">${formatSize(user.storage_used || 0)}</span>
                      </div>
                      <div class="admin-user-row__stat">
                        <span class="text-caption text-muted">Files</span>
                        <span class="text-caption font-semibold">${user.file_count || 0}</span>
                      </div>
                      <div class="admin-user-row__stat">
                        <span class="text-caption text-muted">Uploads</span>
                        <span class="text-caption font-semibold">${user.total_uploads || 0}</span>
                      </div>
                      <div class="admin-user-row__stat">
                        <span class="text-caption text-muted">Sessions</span>
                        <span class="text-caption font-semibold">${user.session_count || 0}</span>
                      </div>
                    </div>
                  </div>
                  <div class="admin-user-row__actions">
                    ${isSuspended
                      ? `<button class="btn btn--dark-utility btn--sm btn-user-restore" data-uid="${user.clerk_id}"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>`
                      : `<button class="btn btn--danger btn--sm btn-user-suspend" data-uid="${user.clerk_id}"><i class="bi bi-slash-circle"></i> Suspend</button>`
                    }
                  </div>
                </div>
              `;
            }).join("");

            // Wire up suspend buttons
            container.querySelectorAll(".btn-user-suspend").forEach((btn: any) => {
              btn.addEventListener("click", async () => {
                const uid = btn.dataset.uid;
                const reason = prompt(`Suspend uploads for user ${uid.slice(0, 16)}…?\n\nPlease enter a reason (this will be shown to the user):`);
                if (reason === null) return; // User cancelled
                
                try {
                  await api.suspendUserUploads(uid, reason || "Violation of terms of service.");
                  showToast("User uploads suspended", "warning");
                  await loadUsers();
                  await loadOverview();
                } catch (err: any) {
                  showToast(err.message || "Action failed", "error");
                }
              });
            });

            // Wire up restore buttons
            container.querySelectorAll(".btn-user-restore").forEach((btn: any) => {
              btn.addEventListener("click", async () => {
                const uid = btn.dataset.uid;
                try {
                  await api.restoreUserAccount(uid, "Restored from admin panel");
                  showToast("User access restored", "success");
                  await loadUsers();
                  await loadOverview();
                } catch (err: any) {
                  showToast(err.message || "Action failed", "error");
                }
              });
            });
          } catch (err: any) {
            loadingDiv.style.display = "none";
            container.innerHTML = '<div class="admin-list__placeholder text-muted text-caption">Failed to load users.</div>';
            showToast("Failed to load users", "error");
          }
        }

        function getActionIcon(action: string): string {
          const icons: Record<string, string> = {
            file_uploaded: '<i class="bi bi-cloud-upload"></i>',
            file_downloaded: '<i class="bi bi-cloud-download"></i>',
            file_deleted: '<i class="bi bi-trash3"></i>',
            session_created: '<i class="bi bi-calendar-plus"></i>',
            session_deleted: '<i class="bi bi-calendar-x"></i>',
            subject_created: '<i class="bi bi-book"></i>',
            work_created: '<i class="bi bi-flask"></i>',
            login: '<i class="bi bi-box-arrow-in-right"></i>',
            admin_resolved_flag: '<i class="bi bi-check-circle"></i>',
            admin_suspended_uploads: '<i class="bi bi-slash-circle"></i>',
            admin_restored_user: '<i class="bi bi-arrow-counterclockwise"></i>',
            abuse_flag_created: '<i class="bi bi-exclamation-triangle"></i>',
            item_restored: '<i class="bi bi-arrow-repeat"></i>',
          };
          return icons[action] || '<i class="bi bi-dot"></i>';
        }

        // Initial load
        await loadOverview();
      });

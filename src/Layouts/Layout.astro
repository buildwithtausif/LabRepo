---
import { Show, UserButton, SignInButton, SignUpButton } from '@clerk/astro/components'

const { title, showNav = true } = Astro.props

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="LabRepo — Safely organize and retrieve your college lab work. Never lose a file again." />
    <title>{title} | LabRepo</title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Syntax Highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlightjs-line-numbers.js/2.8.0/highlightjs-line-numbers.min.js"></script>
  </head>
  <body>
    {showNav && (
      <header class="app-header">
        <div class="app-header__inner">
          <div class="app-header__left">
            <a href="/dashboard" class="app-header__logo">
              <span class="app-header__logo-icon"><i class="bi bi-bezier2"></i></span>
              <span class="app-header__logo-text">LabRepo</span>
              <span class="app-header__logo-tag hide-mobile">student workspace</span>
            </a>
          </div>
          
          <Show when="signed-in">
            <nav class="app-header__nav hide-mobile">
              <a href="/dashboard" class:list={["app-header__link", { active: currentPath === '/dashboard' }]}>
                <i class="bi bi-grid-1x2"></i> Dashboard
              </a>
              <a href="/search" class:list={["app-header__link", { active: currentPath === '/search' }]}>
                <i class="bi bi-search"></i> Search
              </a>
              <a href="/recycle-bin" class:list={["app-header__link", { active: currentPath === '/recycle-bin' }]}>
                <i class="bi bi-trash3"></i> Recycle Bin
              </a>
            </nav>
          </Show>

          <div class="app-header__right">
            <Show when="signed-out">
              <SignInButton mode="modal" asChild={true}>
                <button class="btn btn--dark-utility">Sign In</button>
              </SignInButton>
              <SignUpButton mode="modal" asChild={true}>
                <button class="btn btn--primary">Get Started</button>
              </SignUpButton>
            </Show>
            <Show when="signed-in">
              <UserButton />
            </Show>
          </div>
        </div>

        <!-- Mobile nav -->
        <Show when="signed-in">
          <nav class="app-header__mobile-nav hide-desktop">
            <a href="/dashboard" class:list={["app-header__mobile-link", { active: currentPath === '/dashboard' }]}>
              <span><i class="bi bi-grid-1x2"></i></span><small>Home</small>
            </a>
            <a href="/search" class:list={["app-header__mobile-link", { active: currentPath === '/search' }]}>
              <span><i class="bi bi-search"></i></span><small>Search</small>
            </a>
            <a href="/recycle-bin" class:list={["app-header__mobile-link", { active: currentPath === '/recycle-bin' }]}>
              <span><i class="bi bi-trash3"></i></span><small>Bin</small>
            </a>
          </nav>
        </Show>
      </header>
    )}

    <main class={showNav ? 'app-main' : 'app-main--full'}>
      <slot />
    </main>

    <!-- Footer for landing page -->
    {currentPath === '/' && (
      <footer class="app-footer">
        <div class="container text-center flex flex-col items-center gap-2">
          <p class="text-caption text-muted">&copy; 2026 LabRepo. All rights reserved.</p>
          <div class="flex gap-4 text-caption text-muted mt-2">
            <a href="https://github.com/buildwithtausif" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              Developed by epsilon.void
            </a>
            <span>&bull;</span>
            <a href="mailto:contact@labrepo.com" class="hover:text-white transition-colors">
              Contact Us
            </a>
          </div>
        </div>
      </footer>
    )}

    <script src="../scripts/api.ts"></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* App shell */
  .app-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-nav-bg);
    backdrop-filter: blur(18px);
    padding: 13px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid var(--color-divider);
  }

  .app-header__inner {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    height: 100%;
  }

  .app-header__left {
    display: flex;
    align-items: center;
  }

  .app-header__logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -.04em;
  }

  .app-header__logo-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: white;
    background: var(--color-primary);
    border-radius: 9px;
    font-size: 16px;
  }

  .app-header__logo-tag { color: var(--color-ink-muted); font: 400 11px var(--font-body); letter-spacing: .02em; }

  .app-header__nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .app-header__link {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 11px;
    border-radius: 9px;
    font-size: 13px;
    color: var(--color-ink-muted);
    text-decoration: none;
    letter-spacing: -0.12px;
    transition: color var(--transition-fast);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .app-header__link:hover, .app-header__link.active {
    color: var(--color-ink);
    background: rgba(255,255,255,.07);
  }

  .app-header__link.active { color: #fff; background: var(--color-primary-soft); }

  .app-header__right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Mobile nav */
  .app-header__mobile-nav {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(21, 22, 26, .96);
    padding: 8px 12px;
    margin-top: 13px;
    border-top: 1px solid var(--color-divider);
  }

  .app-header__mobile-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    min-width: 64px;
    padding: 5px 10px;
    border-radius: 9px;
    font-size: 17px;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .app-header__mobile-link.active {
    color: #fff;
    background: var(--color-primary-soft);
  }

  .app-header__mobile-link small { font-size: 10px; font-family: var(--font-body); }

  /* Main content */
  .app-main {
    min-height: calc(100vh - 58px);
    position: relative;
    z-index: 1;
  }

  .app-main--full {
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }
  
  /* Footer */
  .app-footer {
    padding: 34px 0;
    border-top: 1px solid var(--color-divider);
    background-color: rgba(0,0,0,.18);
  }

  @media (min-width: 900px) {
    body:has(#dashboard-page) .app-header__nav { display: none; }
  }

  @media (max-width: 540px) {
    .app-header { padding: 10px 0; }
    .app-header__inner { padding: 0 12px; }
    .app-header__logo { gap: 7px; font-size: 15px; }
    .app-header__logo-icon { width: 28px; height: 28px; border-radius: 8px; font-size: 14px; }
    .app-header__right { gap: 6px; }
    .app-header__right .btn { min-height: 38px; padding: 8px 11px; font-size: .8rem; white-space: nowrap; }
  }

  @media (max-width: 390px) {
    .app-header__logo { font-size: 14px; }
    .app-header__right .btn { padding-inline: 9px; font-size: .74rem; }
  }
</style>
